# Copy this file to `.env` and adjust values.
# The server loads `.env` automatically via dotenv.

NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/buyqk
CORS_ORIGIN=http://localhost:5173
# REQUIRED in production — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Demo Users (auto-seeded on startup) ───
# Available only in development mode (non-production):
#   Regular demo user: demo@buyqk.com  / Demo@1234
#   Admin demo user:  admin@buyqk.com / Admin@1234
#
# Use the /api/auth/demo-login endpoint (development only) to log in
# directly as a demo user without going through the OTP flow:
#   POST /api/auth/demo-login { "role": "user" }   # regular demo
#   POST /api/auth/demo-login { "role": "admin" }   # admin demo
